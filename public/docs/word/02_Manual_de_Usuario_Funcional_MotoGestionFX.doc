      page: Section1;
    }
    body {
      font-family: 'Calibri', 'Segoe UI', Arial, sans-serif;
      font-size: 11pt;
      line-height: 1.6;
      color: #1e293b;
      background-color: #ffffff;
    }
    .header-banner {
      background-color: #0f172a;
      color: #ffffff;
      padding: 18pt 24pt;
      border-radius: 6pt;
      margin-bottom: 24pt;
      border-bottom: 4pt solid #0284c7;
    }
    .header-badge {
      display: inline-block;
      background-color: #0284c7;
      color: #ffffff;
      font-size: 9pt;
      font-weight: bold;
      padding: 3pt 8pt;
      border-radius: 3pt;
      text-transform: uppercase;
      letter-spacing: 1pt;
      margin-bottom: 8pt;
    }
    .footer-note {
      margin-top: 36pt;
      padding-top: 12pt;
      border-top: 1pt solid #cbd5e1;
      font-size: 9pt;
      color: #64748b;
      text-align: center;
    }
    @media print {
      body {
        margin: 0;
        padding: 0;
      }
